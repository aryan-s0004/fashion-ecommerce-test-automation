{
  "name": "fashion-ecommerce-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Black-box Playwright QA automation for the public Myntra website",
  "scripts": {
    "test": "playwright test",
    "test:regression": "playwright test --grep @regression",
    "test:smoke": "playwright test --grep @smoke",
    "test:search": "playwright test --grep @search",
    "test:bag": "playwright test --grep @bag",
    "test:a11y": "playwright test --grep @accessibility",
    "test:responsive": "playwright test --project=chromium-mobile --grep @responsive",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:chromium": "playwright test --project=chromium-desktop",
    "test:firefox": "playwright test --project=firefox-desktop",
    "test:webkit": "playwright test --project=webkit-desktop",
    "auth:setup": "node scripts/setup-auth.mjs",
    "report:summary": "node scripts/summarize-report.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
